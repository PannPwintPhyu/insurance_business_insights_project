CREATE OR ALTER PROCEDURE gold.load_gold AS
BEGIN
    SET NOCOUNT ON;

    DECLARE 
        @start DATETIME,
        @end DATETIME,
        @batch_start DATETIME,
        @batch_end DATETIME;

    SET @batch_start = GETDATE();

    PRINT '==============================================';
    PRINT '           LOADING GOLD LAYER                 ';
    PRINT '==============================================';

    ---------------------------------------------------------
    -- LOAD gold.dim_customer
    ---------------------------------------------------------
    PRINT '--- Loading gold.dim_customer ---';
    TRUNCATE TABLE gold.dim_customer;

    SET @start = GETDATE();
    INSERT INTO gold.dim_customer
    (
        Customer_ID,
        Policy_Holder_Name,
        Gender,
        Age_at_Entry,
        Current_Age,
        Occupation,
        Smoker_Status,
        Medical_Exam_Required,
        Nationality,
        Township
    )
    SELECT
        Customer_ID,
        Policy_Holder_Name,
        Gender,
        Age_at_Entry,
        Current_Age,
        Occupation,
        Smoker_Status,
        Medical_Exam_Required,
        Nationality,
        Township
    FROM silver.dim_customer;
    SET @end = GETDATE();

    PRINT 'Loaded dim_customer in ' + CAST(DATEDIFF(SECOND,@start,@end) AS NVARCHAR);


    ---------------------------------------------------------
    -- LOAD gold.dim_sales_agent
    ---------------------------------------------------------
    PRINT '--- Loading gold.dim_sales_agent ---';
    TRUNCATE TABLE gold.dim_sales_agent;

    SET @start = GETDATE();
    INSERT INTO gold.dim_sales_agent
    (
        Agent_Code,
        Sales_Agent,
        Agent_Mail,
        Township
    )
    SELECT
        Agent_Code,
        Sales_Agent,
        Agent_Mail,
        Township
    FROM silver.dim_agent;
    SET @end = GETDATE();

    PRINT 'Loaded dim_sales_agent in ' + CAST(DATEDIFF(SECOND,@start,@end) AS NVARCHAR);


    ---------------------------------------------------------
    -- LOAD gold.dim_regional_manager
    ---------------------------------------------------------
    PRINT '--- Loading gold.dim_regional_manager ---';
    TRUNCATE TABLE gold.dim_regional_manager;

    SET @start = GETDATE();
    INSERT INTO gold.dim_regional_manager
    (
        Regional_Manager_ID,
        Regional_Manager_Name,
        Mail,
        Region,
        States_Covered
    )
    SELECT
        Regional_Manager_ID,
        Regional_Manager_Name,
        Mail,
        Region,
        States_Covered
    FROM silver.dim_regional_manager;
    SET @end = GETDATE();

    PRINT 'Loaded dim_regional_manager in ' + CAST(DATEDIFF(SECOND,@start,@end) AS NVARCHAR);


    ---------------------------------------------------------
    -- LOAD gold.fact_insurance_policy 
    ---------------------------------------------------------
    PRINT '--- Loading gold.fact_insurance_policy ---';
    TRUNCATE TABLE gold.fact_insurance_policy;

    SET @start = GETDATE();
    INSERT INTO gold.fact_insurance_policy
    SELECT *
    FROM gold.vw_insurance_policy_enriched;
    SET @end = GETDATE();

    PRINT 'Loaded fact_insurance_policy in ' + CAST(DATEDIFF(SECOND,@start,@end) AS NVARCHAR);


    ---------------------------------------------------------
    -- END
    ---------------------------------------------------------
    SET @batch_end = GETDATE();
    PRINT '==============================================';
    PRINT ' GOLD Layer Load Completed Successfully';
    PRINT ' Total Duration: ' + CAST(DATEDIFF(SECOND,@batch_start,@batch_end) AS NVARCHAR) + ' seconds';
    PRINT '==============================================';
END;
GO
